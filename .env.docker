APP_NAME="OpenMultipleChoice"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_POWEREDBY=true
APP_LOGIN_FORM=true
APP_LOGIN_KEYCLOAK=false
APP_SIGNUP_ENABLED=false
APP_USERS_ENABLE_DECK_EXPORT=false
APP_USERS_ENABLE_DECK_IMPORT=false
APP_TIMEZONE_VIEW=UTC

ASSET_URL=http://localhost:8000

TRUSTEDPROXY_PROXIES='127.0.0.1'

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
